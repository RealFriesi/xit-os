#!/bin/bash
# Add every human account to the `input` group.
#
# DMS reads /dev/input/event* directly (evdev) for the Caps Lock OSD and the
# bar indicator. `dms setup` would run `usermod -aG input $USER`, but at image
# build time no user exists yet, so this runs on every boot instead. It is
# idempotent and never fails the boot.

set -uo pipefail

if ! getent group input >/dev/null; then
	exit 0
fi

status=0
while IFS=: read -r name _ uid _; do
	if ((uid < 1000 || uid >= 65534)); then
		continue
	fi
	if id -nG "${name}" 2>/dev/null | tr ' ' '\n' | grep -qx input; then
		continue
	fi
	if ! usermod -aG input "${name}"; then
		printf 'Could not add %s to the input group\n' "${name}" >&2
		status=1
	fi
done < <(getent passwd)

exit "${status}"
